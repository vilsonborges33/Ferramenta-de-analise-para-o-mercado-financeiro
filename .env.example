# Copie para .env e ajuste. Nunca coloque o .env no git.

POSTGRES_USER=analise
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=analise

# Segredo das sessões (gere um valor aleatório longo, ex.: `openssl rand -hex 32`).
JWT_SEGREDO=
COOKIE_SEGURO=false
CORS_ORIGENS=http://localhost:3000

# Identificação enviada às fontes de dados no cabeçalho User-Agent.
CONTATO_USER_AGENT=analise-mercado (contato: seu-email@exemplo.com)

# Cotações e dividendos: "yahoo" (padrão) ou "b3" (COTAHIST + proventos da B3/FNET).
FONTE_MERCADO=yahoo

# brapi.dev: token opcional no plano gratuito; proventos exigem plano pago.
BRAPI_TOKEN=
BRAPI_PROVENTOS_HABILITADO=false

# Mercado dos EUA (Fase 7). A SEC exige um contato real; CONTATO_SEC só é enviado à SEC.
CONTATO_SEC=analise-mercado seu-email@exemplo.com
# TICKERS_EUA vazio = todas as empresas listadas na NYSE/Nasdaq/Cboe (~6 mil; a primeira carga baixa ~1 GB da SEC
# e leva horas para buscar as cotações). Preencha (ex.: AAPL,MSFT,KO) para acompanhar só uma lista.
# ETFS_EUA vazio = SPY, VOO, VTI, QQQ, SCHD, VNQ, VXUS e BND.
TICKERS_EUA=
ETFS_EUA=

# Tickers consultados diariamente na brapi (separados por vírgula).
TICKERS_ACOMPANHADOS=PETR4,VALE3,ITUB4,WEGE3,ABEV3,EGIE3,MGLU3,RADL3,TAEE11,SUZB3,HGLG11,KNRI11,MXRF11,XPML11,VISC11,HGRU11,KNCR11,BTLG11,HSML11,RBRF11

# Alertas por e-mail (opcional). Ex.: Gmail = smtp.gmail.com, porta 587, usuário = seu e-mail e
# SMTP_SENHA = "senha de app" gerada na conta Google. Vazio = alertas só aparecem na tela de Alertas.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
